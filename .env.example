# Cities to fetch weather for (comma separated)
CITIES=["Helsinki","Tampere","Pori","Turku","Oulu","Rovaniemi","Jyväskylä","Espoo","Vantaa","Lahti"]

# Open-Meteo API base URL (no key needed)
API_BASE_URL=https://api.open-meteo.com/v1

# DuckDB database file path
DB_PATH=data/weather.duckdb

# Log level
LOG_LEVEL=INFO
