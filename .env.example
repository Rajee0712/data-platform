# Log level
LOG_LEVEL=INFO

# DuckDB database file path
DB_PATH=data/platform.duckdb

# Weather pipeline - Open-Meteo API base URL (no key needed)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Air quality pipeline - Open-Meteo API base URL (no key needed)
AIR_QUALITY_API_BASE_URL=https://air-quality-api.open-meteo.com/v1
